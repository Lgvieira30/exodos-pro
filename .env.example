# Servidor
PORT=3001
NODE_ENV=production

# JWT
JWT_SECRET=sua_chave_secreta_muito_forte_aqui_minimo_32_chars
JWT_EXPIRES_IN=24h

# PostgreSQL local no servidor (use host.docker.internal para acessar o banco do host)
# DATABASE_URL=postgresql://usuario:senha@host.docker.internal:5432/nome_do_banco
# PostgreSQL remoto (Neon)
# DATABASE_URL=postgresql://usuario:senha@host.neon.tech/exodos_pro?sslmode=require
DATABASE_URL=postgresql://usuario:senha@host.docker.internal:5432/nome_do_banco

# Frontend (CORS — deixe vazio se frontend e backend estão na mesma URL)
FRONTEND_URL=

# Meta Ads — login OAuth "Conectar com Facebook" (nivel plataforma)
# Crie um app em developers.facebook.com, adicione o produto "Facebook Login"
# e registre a redirect URI abaixo em "Valid OAuth Redirect URIs".
META_APP_ID=
META_APP_SECRET=
# Deve bater EXATAMENTE com a URI registrada no app do Facebook:
# ex.: https://SEU-BACKEND/api/integrations/meta/oauth/callback
META_OAUTH_REDIRECT_URI=
META_ACCESS_TOKEN=

# Google Ads — login OAuth "Entrar com Google" (nivel plataforma)
# Crie um OAuth Client (tipo "Aplicativo da Web") no Google Cloud Console e
# registre a URI de redirect abaixo em "URIs de redirecionamento autorizados".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DEVELOPER_TOKEN=
# Deve bater EXATAMENTE com a URI registrada no Google Cloud Console:
# ex.: https://SEU-BACKEND/api/integrations/google/oauth/callback
GOOGLE_OAUTH_REDIRECT_URI=
